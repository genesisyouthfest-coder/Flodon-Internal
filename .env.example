# ═══════════════════════════════════════════════
#  FLODON INTERNAL — Environment Template
# ═══════════════════════════════════════════════

# Discord Bot
DISCORD_TOKEN=your_discord_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_guild_id_here

# Supabase (Service Role — bypasses RLS)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Discord Channel IDs
CHANNEL_WEB_LEADS=id_here
CHANNEL_DEALS=id_here
CHANNEL_OUTREACH=id_here
CHANNEL_CALLS=id_here
CHANNEL_PAYMENTS=id_here
CHANNEL_WARROOM=id_here
CHANNEL_MILESTONES=id_here

# CRM Webhook Auth
CRM_WEBHOOK_TOKEN=your_secure_token_here

# Gmail SMTP (Email Notifications — fallback if DB not configured)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
GMAIL_FROM_NAME=Flodon Operations
ADMIN_EMAIL=your_admin_email@gmail.com

# Ports
BOT_PORT=10010
API_PORT=10011

# Roles
ROLE_SALES=your_sales_role_id_here
