{
  "name": "flodon-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bot:dev": "npm run dev -w apps/internal-software",
    "software:dev": "npm run dev -w apps/internal-software",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build internal-software",
    "lint": "eslint 'packages/*/src/**/*.js' 'apps/*/src/**/*.js'",
    "lint:fix": "eslint --fix 'packages/*/src/**/*.js' 'apps/*/src/**/*.js'",
    "format": "prettier --write 'packages/*/src/**/*.js' 'apps/*/src/**/*.js'",
    "format:check": "prettier --check 'packages/*/src/**/*.js' 'apps/*/src/**/*.js'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "echo 'No TypeScript check configured yet'",
    "ci": "npm run lint && npm run format:check && npm run test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "vitest": "^2.0.0"
  }
}
